# Copy to .env and fill in real values. Never commit .env.

# Public hostname of the server (Azure: the VM's DNS name label). Used by Caddy for HTTPS.
DOMAIN=zai-example.polandcentral.cloudapp.azure.com

# PostgreSQL
POSTGRES_DB=zai
POSTGRES_USER=zai
POSTGRES_PASSWORD=change-me-long-random-password

# Initial administrator account (created on the first start of the backend).
# At least 8 characters, so the password can be changed and restored through the API.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Comma-separated origins allowed by CORS (the frontend's URL in E2).
CORS_ALLOWED_ORIGINS=*

# Optional: key of a registered sensor, for the sensor_server container's live mode.
SENSOR_API_KEY=
# Seconds between the sensor_server container's live readings (60 = every minute).
SENSOR_INTERVAL=60
